{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authentic external source metadata (data not distributed)",
  "type": "object",
  "required": [
    "field_sites",
    "mapped_predictors",
    "potassium_product_rate_kg_ha",
    "potassium_k2o_mass_fraction"
  ],
  "additionalProperties": false,
  "properties": {
    "field_sites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "year",
          "site",
          "latitude",
          "longitude"
        ],
        "additionalProperties": false,
        "properties": {
          "year": {
            "type": "integer"
          },
          "site": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      }
    },
    "mapped_predictors": {
      "type": "object",
      "required": [
        "crop",
        "climate_zone",
        "soil_texture",
        "inoculant_function",
        "irrigation_status",
        "fertilization_type"
      ],
      "additionalProperties": false,
      "properties": {
        "crop": {
          "type": "string",
          "minLength": 1
        },
        "climate_zone": {
          "type": "string",
          "minLength": 1
        },
        "soil_texture": {
          "type": "string",
          "minLength": 1
        },
        "inoculant_function": {
          "type": "integer"
        },
        "irrigation_status": {
          "type": "integer"
        },
        "fertilization_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "potassium_product_rate_kg_ha": {
      "type": "number",
      "minimum": 0
    },
    "potassium_k2o_mass_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
